# ---- Required -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# At least one AI key. With both, every page is read by both models and the
# answers are merged / voted on (most accurate).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Access -----------------------------------------------------------------
# Comma-separated Telegram user ids allowed to use the bot (send /id to the bot to get yours).
# Empty = everyone (not recommended: strangers would spend your API credit).
ALLOWED_USER_IDS=

# ---- AI (optional) ----------------------------------------------------------
CLAUDE_MODEL=claude-opus-5
OPENAI_MODEL=gpt-6-astra
# OpenAI-compatible gateway, only if you use one (leave empty for api.openai.com)
OPENAI_BASE_URL=
OPENAI_IMAGE_DETAIL=original
# Which model leads (the other one verifies and takes over on errors)
AI_PROVIDERS=claude,openai
# 1 = when both keys are set, analyse every page with both models (recommended)
AI_CONSENSUS=1
# low | medium | high | xhigh | max
AI_EFFORT_IMAGE=high
AI_EFFORT_TEXT=medium
AI_EFFORT_COMMAND=medium
AI_EFFORT_TABLE=medium
AI_VERIFY_IMAGE_PRICES=1
AI_PARALLEL_PAGES=4

# ---- Limits / output ------------------------------------------------------------
MAX_PDF_PAGES=60
SESSION_TTL_MINUTES=180
IMAGE_EXPORT_DPI=200
LOG_LEVEL=INFO
