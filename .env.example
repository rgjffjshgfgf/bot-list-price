# ---- Required -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Access -----------------------------------------------------------------
# Comma-separated Telegram user ids allowed to use the bot (send /id to the bot to get yours).
# Empty = everyone (not recommended: strangers would use up your free daily quota).
ALLOWED_USER_IDS=

# ---- Gemini models and free-tier limits (optional) ---------------------------
# Smarter model, small free quota: photos / scans and free-form commands
GEMINI_MODEL=gemini-flash-latest
GEMINI_RPM=10
GEMINI_RPD=20
# Lighter model, large free quota: text PDFs, Excel, re-reads; takes over when Flash runs out
GEMINI_LITE_MODEL=gemini-flash-lite-latest
GEMINI_LITE_RPM=15
GEMINI_LITE_RPD=500
# 1 = read every page with both models and merge (more accurate, twice the quota)
AI_CONSENSUS=0
# low | medium | high
AI_EFFORT_IMAGE=high
AI_EFFORT_TEXT=low
AI_EFFORT_COMMAND=medium
AI_EFFORT_TABLE=low
AI_VERIFY_IMAGE_PRICES=1
AI_PARALLEL_PAGES=3

# ---- Limits / storage ------------------------------------------------------------
MAX_PDF_PAGES=60
SESSION_TTL_MINUTES=180
IMAGE_EXPORT_DPI=200
# A Railway volume mounted at /data is used automatically for everything that must last
# (what the bot has learned, the quota counter). Override only if the volume is elsewhere:
# DATA_DIR=/data

# ---- The bot's own AI ("brain") -----------------------------------------------------
# auto = known formats without Gemini, new ones with Gemini as teacher (learning)
# teacher = always Gemini, keep learning | local = never Gemini for finding prices | off = old behaviour
BRAIN_MODE=auto
# checked answers in a row before a list format is handled without Gemini
BRAIN_TRUST_AFTER=2
# whole pages in a row the model must get right before it handles unseen formats alone
BRAIN_GENERAL_AFTER=20
# BRAIN_DIR=/data/brain
LOG_LEVEL=INFO
